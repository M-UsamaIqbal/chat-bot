# ============================================================================
# AI Support Chatbot — Environment Variables
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local`. Only secrets prefixed with NEXT_PUBLIC_ are
# exposed to the browser — everything else stays server-side only.
# ============================================================================

# ----------------------------------------------------------------------------
# AI provider (chat)
# The app uses the OpenAI-compatible Chat Completions protocol, so you can plug
# in a FREE provider. Default below = Groq (free, no credit card).
#
#   FREE / Groq  ->  https://console.groq.com/keys  (create an API key)
#   AI_API_KEY = your Groq key (starts with gsk_...)
#   AI_BASE_URL = https://api.groq.com/openai/v1
#   AI_MODEL    = llama-3.3-70b-versatile
#
# Prefer OpenAI instead? Leave AI_BASE_URL empty, set AI_API_KEY=sk-... and
# AI_MODEL=gpt-4o-mini. Other OpenAI-compatible providers work the same way.
# Server-side only — never exposed to the browser.
# ----------------------------------------------------------------------------
AI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------------------------
# Supabase  (https://supabase.com/dashboard -> Project Settings -> API)
# ----------------------------------------------------------------------------
# Public project URL + anon key — safe to expose to the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# Service-role key — FULL DATABASE ACCESS. SERVER-SIDE ONLY. Never expose.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
# Public base URL of this deployment (used for the embed snippet + widget iframe).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The default organization slug served for the single-tenant launch.
NEXT_PUBLIC_DEFAULT_ORG_SLUG=support

# ----------------------------------------------------------------------------
# Admin bootstrap (used once by scripts/create-admin.mjs to create your login)
# ----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Simple shared secret used to rate-limit / sign widget requests (optional in dev).
WIDGET_PUBLIC_KEY=wta_public_dev_key
